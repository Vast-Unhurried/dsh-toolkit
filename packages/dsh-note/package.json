{
  "name": "dsh-note",
  "version": "1.3.0",
  "description": "DeepSeek Harness 原生便签：在输入框权限选择器（Full access）右侧放一个与周边图标同款的便签按钮，点击弹出可编辑便签，内容自动保存到磁盘（$DSH_HOME/storages/dsh-note.json）；不改动 Harness 核心。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
    "author": "Vast-Unhurried",
"license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-host-webserver": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    }
  }
}
